{
  "name": "frontend-design-prototypes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:rede": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "build:verificacao": "NEXT_PUBLIC_VERIFICACAO=1 next build",
    "start:verificacao": "NEXT_PUBLIC_VERIFICACAO=1 next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verificar:screenshots": "node scripts/screenshots.ts",
    "verificar:fps": "node scripts/medir-fps.ts",
    "verificar:lighthouse": "node scripts/lighthouse.mjs",
    "verificar:estilos": "node scripts/comparar-estilos.ts",
    "verificar:padroes": "node scripts/checar-padroes.ts",
    "verificar:testes": "playwright test",
    "analisar": "ANALYZE=1 next build --webpack"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "maath": "0.10.8",
    "motion": "14.1.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.2",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.5.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
