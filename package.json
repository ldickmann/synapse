{
  "name": "synapse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:rede": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "node scripts/servir.ts",
    "lint": "eslint .",
    "formatar": "prettier --write .",
    "formatar:checar": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "verificar:screenshots": "node scripts/screenshots.ts",
    "verificar:lighthouse": "node scripts/lighthouse.mjs",
    "verificar:padroes": "node scripts/checar-padroes.ts",
    "verificar:testes": "playwright test",
    "analisar": "ANALYZE=1 next build --webpack",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "husky": "9.1.7",
    "lighthouse": "13.6.0",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
