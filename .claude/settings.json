{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint *)",
      "PowerShell(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "PowerShell(pnpm typecheck *)",
      "Bash(pnpm build *)",
      "PowerShell(pnpm build *)",
      "Bash(pnpm formatar *)",
      "PowerShell(pnpm formatar *)",
      "Bash(pnpm formatar:checar *)",
      "PowerShell(pnpm formatar:checar *)",
      "Bash(pnpm verificar:padroes *)",
      "PowerShell(pnpm verificar:padroes *)",
      "Bash(pnpm verificar:testes *)",
      "PowerShell(pnpm verificar:testes *)",
      "Bash(pnpm verificar:screenshots *)",
      "PowerShell(pnpm verificar:screenshots *)",
      "Bash(pnpm verificar:lighthouse *)",
      "PowerShell(pnpm verificar:lighthouse *)",
      "Bash(git switch -c *)",
      "PowerShell(git switch -c *)",
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(gh pr view *)",
      "PowerShell(gh pr view *)",
      "Bash(gh pr checks *)",
      "PowerShell(gh pr checks *)",
      "Bash(gh run view *)",
      "PowerShell(gh run view *)"
    ],
    "ask": ["Bash(gh api *)", "PowerShell(gh api *)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push)",
      "PowerShell(git push)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(gh release *)",
      "PowerShell(gh release *)",
      "Bash(vercel *)",
      "PowerShell(vercel *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/contexto-da-sessao.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger-git.mjs"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger-arquivos.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/formatar.mjs"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/verificar-ao-parar.mjs"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
